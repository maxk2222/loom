[Unit]
Description=LOOM Client (local inference node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loom-client
Group=loom-client
EnvironmentFile=-/etc/loom-client/enroll.env
Environment=LOOM_CONFIG=/etc/loom-client/config.toml
# The binary lives under ReadWritePaths so the self-updater can swap it in
# place — /usr/local/bin is read-only under ProtectSystem=strict.
ExecStart=/var/lib/loom-client/bin/loom-client
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/loom-client

[Install]
WantedBy=multi-user.target

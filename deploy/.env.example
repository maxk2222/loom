# LOOM server stack
POSTGRES_USER=loom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loom
REDIS_PASSWORD=
LOOM_REDIS_PREFIX=loom:prod:
LOOM_DOMAIN=loom.example.com
RUST_LOG=info,loom_server=debug

# Cloudflare Tunnel (optional, replaces caddy): enable with
#   docker compose --profile tunnel up -d
# Trust CF headers only when the tunnel is the only public path to :8080.
#CF_TUNNEL_TOKEN=
#LOOM_TRUST_PROXY=1
# Public gRPC via the tunnel: point grpc.<domain> at the bootstrap
# listener — service https://server:50053 with "No TLS Verify" + "HTTP/2
# to origin" (released cloudflared cannot proxy h2c). Needs server TLS
# cert+key; bootstrap reuses them and requires no client cert.
#LOOM_GRPC_BOOTSTRAP_BIND=0.0.0.0:50053
#LOOM_GRPC_TLS_CERT=/data/tls/server.crt
#LOOM_GRPC_TLS_KEY=/data/tls/server.key
#LOOM_MTLS=1
# Cleartext h2c alternative once cloudflared ships prior-knowledge h2c —
# never map it to a host port:
#LOOM_GRPC_PLAIN_BIND=0.0.0.0:50054

# LOOM server stack
POSTGRES_USER=loom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loom
REDIS_PASSWORD=
LOOM_REDIS_PREFIX=loom:prod:
LOOM_DOMAIN=loom.example.com
RUST_LOG=info,loom_server=debug


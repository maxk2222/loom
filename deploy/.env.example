# LOOM server stack
POSTGRES_USER=loom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loom
REDIS_PASSWORD=
LOOM_REDIS_PREFIX=loom:prod:
LOOM_DOMAIN=loom.example.com
RUST_LOG=info,loom_server=debug

# Cloudflare Tunnel (optional, replaces caddy): enable with
#   docker compose --profile tunnel up -d
# Trust CF headers only when the tunnel is the only public path to :8080.
#CF_TUNNEL_TOKEN=
#LOOM_TRUST_PROXY=1
# Plaintext h2c agent listener for public clients via the tunnel
# (grpc.<domain> public hostname -> http://server:<port>, gRPC enabled in
# Cloudflare Network settings). Internal-only, no host port map needed.
#LOOM_GRPC_PLAIN_BIND=0.0.0.0:50054

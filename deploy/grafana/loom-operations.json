{
  "uid": "loom-ops",
  "title": "LOOM Operations",
  "description": "LOOM control plane: request flow, TTFT, queue depth, clients — plus vLLM capacity context.",
  "tags": ["loom"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
